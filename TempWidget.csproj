<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TempWidget.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TempWidget</AssemblyName>
    <RootNamespace>TempWidget</RootNamespace>
    <Version>2.1.3</Version>
    <Product>TempWidget</Product>
    <Description>Lightweight desktop widget for temperatures, fans and other hardware sensors</Description>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" Condition="'$(OfflineReferenceDirectory)' == ''" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(OfflineReferenceDirectory)' == ''" />
  </ItemGroup>
  <!-- Optional local fallback for auditing an existing portable release without network access. -->
  <ItemGroup Condition="'$(OfflineReferenceDirectory)' != ''">
    <Reference Include="$(OfflineReferenceDirectory)\*.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="package\**;dist\**;tests\**" />
    <None Remove="package\**;dist\**;tests\**" />
  </ItemGroup>
</Project>
