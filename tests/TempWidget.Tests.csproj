<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TempWidget.Tests</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\package\AppxManifest.xml" Link="Fixtures\AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\TempWidget.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(OfflineReferenceDirectory)' == ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfflineReferenceDirectory)' != ''">
    <Reference Include="$(OfflineReferenceDirectory)\*.dll" />
  </ItemGroup>
</Project>
